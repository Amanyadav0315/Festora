PORT=4000
MONGO_URI=mongodb://localhost:27017/eventsaman
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ADMIN_TOKEN_TTL=24h
USER_TOKEN_TTL=30d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Resend — active email provider, used to send OTP emails (signup verification, password
# reset). Get an API key from https://resend.com/api-keys, and verify the eventsaman.com
# sending domain in the Resend dashboard before FROM_EMAIL will actually deliver.
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=noreply@eventsaman.com
FROM_NAME=Event Saman
# Public site URL used to build the password-reset link included in reset emails.
SITE_URL=http://localhost:3000

# AWS SES SMTP — kept here for reference only; not currently used (see
# src/lib/email.service.ts). Set these and swap the implementation in email.service.ts to
# switch the active provider from Resend back to SES.
AWS_SES_SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=<your smtp username>
AWS_SES_SMTP_PASS=<your smtp password>
